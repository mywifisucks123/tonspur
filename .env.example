# Kopieren nach .env und ausfüllen.

PORT=3000
HOST=0.0.0.0

# --- Jellyfin -------------------------------------------------------------
# PM2 (nativ auf dem Mac): localhost. Docker: wird in docker-compose.yml
# automatisch auf host.docker.internal umgebogen.
JELLYFIN_URL=http://localhost:8096
# Jellyfin → Dashboard → API-Schlüssel → "+"
JELLYFIN_API_KEY=
# Optional. Leer = erster Admin-User wird automatisch genommen.
JELLYFIN_USER_ID=
# Optional. Leer = komplette Bibliothek scannen (/Library/Refresh).
# Mit ID der Musik-Bibliothek wird nur diese gescannt.
JELLYFIN_MUSIC_LIBRARY_ID=
# static = Originaldatei (FLAC/MP3, volle Qualität, spulbar)
# mp3    = Jellyfin transkodiert auf MP3 320 (spart mobiles Datenvolumen)
JELLYFIN_STREAM_MODE=static
# Wartezeit nach dem letzten fertigen Download, bevor der Scan läuft (ms)
JELLYFIN_SCAN_DELAY_MS=15000

# --- Deemix ---------------------------------------------------------------
DEEMIX_URL=http://localhost:6595
# ARL aus dem Deemix-Container: docker exec deemix cat /config/.arl
DEEMIX_ARL=
# 9 = FLAC, 3 = MP3 320, 1 = MP3 128
DEEMIX_BITRATE=9

# --- Sofort-Wiedergabe ----------------------------------------------------
# Volle Songs per yt-dlp streamen, solange sie noch nicht in Jellyfin liegen.
# false = nur 30-Sekunden-Vorschau von Deezer.
YTDLP_ENABLED=true
YTDLP_BIN=yt-dlp
# Unter PM2/launchd findet sich Homebrew nicht immer im PATH → dann vollen Pfad
# eintragen: /opt/homebrew/bin/yt-dlp
# Zusätzliche Argumente. Die JS-Runtime (Deno oder Node) wird automatisch gesetzt.
YTDLP_EXTRA_ARGS=
# music = YouTube-Music-Suche (offizielle Audio-Versionen), youtube = normale Suche
YT_SEARCH=music
YTDLP_CONCURRENCY=2
# Länger als das wartet der Stream nicht auf yt-dlp, dann kommt die Vorschau
STREAM_RESOLVE_TIMEOUT_MS=8000

# --- Verhalten ------------------------------------------------------------
# Jeder abgespielte Song wird automatisch in die Bibliothek geladen
AUTO_DOWNLOAD_ON_PLAY=true
